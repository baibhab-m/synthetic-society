# OpenAI-compatible LLM endpoint. Any provider works: OpenAI, OpenRouter, Groq, Together,
# DashScope (Qwen), Sarvam, Anthropic-via-router, local llama.cpp, etc.
LLM_API_KEY=sk-replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional: lower temperature for graph extraction, higher for agents.
LLM_TEMP_EXTRACT=0.0
LLM_TEMP_AGENT=0.7
LLM_TEMP_REPORT=0.3

# Storage: SQLite by default (zero-setup). Swap to Postgres by changing DATABASE_URL.
DATABASE_URL=sqlite+aiosqlite:///./synthetic_society.db

# Run knobs
MAX_AGENTS_PER_SIM=200
MAX_ROUNDS=20
PARALLEL_AGENTS=8

# Server
HOST=0.0.0.0
PORT=8765